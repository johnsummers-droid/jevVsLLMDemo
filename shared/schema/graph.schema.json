      "additionalProperties": false,
      "properties": {
        "teamId": {
          "type": "string"
        },
        "version": {
          "minimum": 0,
          "type": "integer"
        },
        "locked": {
          "default": false,
          "type": "boolean"
        },
        "graph": {
          "$ref": "#/$defs/Graph"
        },
        "updatedAt": {
          "format": "date-time",
          "type": "string"
        }
      },
      "required": [
        "teamId",
        "version",
        "graph",
        "updatedAt"
