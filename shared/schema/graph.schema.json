          "const": 1,
          "type": "integer"
        },
        "nodes": {
          "items": {
            "$ref": "#/$defs/GraphNode"
          },
          "maxItems": 40,
          "type": "array"
        },
        "edges": {
          "items": {
            "$ref": "#/$defs/GraphEdge"
          },
          "maxItems": 80,
          "type": "array"
        }
      },
      "required": [
        "nodes",
        "edges",
        "schemaVersion"
      ],
      "title": "Graph",
      "type": "object"
    },
    "GraphEdge": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "minLength": 1,
          "type": "string"
        },
        "source": {
          "type": "string"
        },
        "sourcePort": {
          "type": "string"
        },
        "target": {
          "type": "string"
        },
        "targetPort": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "source",
        "sourcePort",
        "target",
        "targetPort"
      ],
      "title": "GraphEdge",
      "type": "object"
    },
    "GraphNode": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "minLength": 1,
          "type": "string"
        },
        "type": {
          "type": "string"
        },
        "position": {
          "$ref": "#/$defs/Position"
        },
        "params": {
          "additionalProperties": true,
          "type": "object"
        },
        "label": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "id",
        "type",
        "position"
      ],
      "title": "GraphNode",
      "type": "object"
    },
    "Position": {
      "additionalProperties": false,
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        }
      },
      "required": [
        "x",
        "y"
      ],
      "title": "Position",
      "type": "object"
    },
    "SaveGraphRequest": {
      "additionalProperties": false,
      "description": "PUT /api/teams/{id}/graph: `version` is the version the client last loaded.",
      "properties": {
        "version": {
          "minimum": 0,
          "type": "integer"
        },
        "graph": {
