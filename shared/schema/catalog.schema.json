        "help": {
          "default": "",
          "type": "string"
        },
        "kind": {
          "const": "number",
          "type": "string"
        },
        "default": {
          "type": "number"
        },
        "min": {
          "type": "number"
        },
        "max": {
          "type": "number"
        },
        "step": {
          "default": 0.05,
          "type": "number"
