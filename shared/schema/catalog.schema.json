          },
          "type": "array"
        }
      },
      "required": [
        "nodes"
      ],
      "title": "CatalogResponse",
      "type": "object"
    },
    "CostModel": {
      "additionalProperties": false,
      "properties": {
        "latencyMs": {
          "minimum": 0,
          "type": "number"
        },
        "latencyJitterMs": {
          "default": 0,
          "minimum": 0,
          "type": "number"
        },
        "costPerCallUsd": {
          "default": 0,
          "minimum": 0,
          "type": "number"
        },
        "perTokenLatencyMs": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "priceInPer1KUsd": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "priceOutPer1KUsd": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "excludedFromLatency": {
          "default": false,
          "type": "boolean"
        }
      },
      "required": [
        "latencyMs"
      ],
      "title": "CostModel",
      "type": "object"
    },
    "EnumParam": {
      "additionalProperties": false,
      "properties": {
        "key": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "help": {
          "default": "",
          "type": "string"
        },
        "kind": {
          "const": "enum",
          "type": "string"
        },
        "default": {
          "type": "string"
        },
        "options": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "type": "array"
        }
      },
      "required": [
        "key",
        "label",
        "default",
        "options",
        "kind"
      ],
      "title": "EnumParam",
      "type": "object"
    },
    "HelpExample": {
      "additionalProperties": false,
      "description": "A worked example for the help panel. A test runs it through the node's runner on the\nmock providers (run seed 0) and checks the stated outputs (plan1.txt S5).",
      "properties": {
        "ticketId": {
          "pattern": "^p-[0-9]+$",
          "type": "string"
        },
        "inputText": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "params": {
          "additionalProperties": true,
          "type": "object"
        },
        "firedBranch": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "outputs": {
          "additionalProperties": true,
          "type": "object"
        },
        "explanation": {
          "type": "string"
        }
      },
      "required": [
        "ticketId",
        "explanation"
      ],
      "title": "HelpExample",
      "type": "object"
    },
    "IntParam": {
      "additionalProperties": false,
      "properties": {
        "key": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "help": {
          "default": "",
          "type": "string"
        },
        "kind": {
          "const": "int",
          "type": "string"
        },
        "default": {
          "type": "integer"
        },
        "min": {
          "type": "integer"
        },
        "max": {
          "type": "integer"
        }
