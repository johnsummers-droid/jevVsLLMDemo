{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "catalog.schema.json",
  "title": "catalog",
  "description": "GENERATED by server/scripts/export_schema.py. Do not edit.",
  "$defs": {
    "BoolParam": {
      "additionalProperties": false,
      "properties": {
        "key": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "help": {
          "default": "",
          "type": "string"
        },
        "kind": {
          "const": "bool",
          "type": "string"
        },
        "default": {
          "type": "boolean"
        }
      },
      "required": [
        "key",
        "label",
        "default",
        "kind"
      ],
      "title": "BoolParam",
      "type": "object"
    },
    "CatalogResponse": {
      "additionalProperties": false,
      "properties": {
