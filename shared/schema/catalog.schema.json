      "title": "NodeCategory",
      "enum": [
        "io",
        "jev",
        "llm",
        "tool",
        "human"
      ],
      "type": "string"
    },
    "NodeDefinition": {
      "additionalProperties": false,
      "description": "Serializable node metadata. The run() behavior lives in the server-side registry.",
      "properties": {
        "type": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "category": {
          "$ref": "#/$defs/NodeCategory"
        },
        "description": {
          "type": "string"
        },
        "inputs": {
          "items": {
            "$ref": "#/$defs/Port"
          },
          "type": "array"
        },
        "outputs": {
          "items": {
            "$ref": "#/$defs/Port"
          },
          "type": "array"
        },
        "params": {
          "items": {
            "$ref": "#/$defs/ParamSpec"
          },
          "type": "array"
        },
        "costModel": {
          "$ref": "#/$defs/CostModel"
