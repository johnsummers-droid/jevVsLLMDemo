        "requiresOneOf": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "isSource": {
          "default": false,
          "type": "boolean"
        },
        "isSink": {
          "default": false,
          "type": "boolean"
        },
        "mvp": {
          "default": true,
          "type": "boolean"
        },
        "help": {
          "anyOf": [
            {
              "$ref": "#/$defs/NodeHelp"
