        "key",
        "label",
        "default",
        "min",
        "max",
        "kind"
      ],
      "title": "NumberParam",
      "type": "object"
    },
    "ParamSpec": {
      "title": "ParamSpec",
      "discriminator": {
        "mapping": {
          "bool": "#/$defs/BoolParam",
          "enum": "#/$defs/EnumParam",
          "int": "#/$defs/IntParam",
          "multi_enum": "#/$defs/MultiEnumParam",
          "number": "#/$defs/NumberParam",
          "string_list": "#/$defs/StringListParam",
          "text": "#/$defs/TextParam"
        },
        "propertyName": "kind"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/NumberParam"
        },
        {
          "$ref": "#/$defs/IntParam"
        },
        {
          "$ref": "#/$defs/EnumParam"
        },
        {
          "$ref": "#/$defs/MultiEnumParam"
        },
        {
          "$ref": "#/$defs/StringListParam"
        },
        {
          "$ref": "#/$defs/TextParam"
        },
        {
          "$ref": "#/$defs/BoolParam"
        }
      ]
    },
    "Port": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "type": {
          "$ref": "#/$defs/PortType"
        },
        "required": {
          "default": true,
          "type": "boolean"
        },
        "multi": {
          "default": false,
          "type": "boolean"
        },
        "branch": {
          "default": false,
          "type": "boolean"
        },
        "enumValues": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "scoreRange": {
          "anyOf": [
            {
              "maxItems": 2,
              "minItems": 2,
              "prefixItems": [
                {
                  "type": "integer"
                },
                {
                  "type": "integer"
                }
              ],
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "jsonSchemaRef": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
