    "TextParam": {
      "additionalProperties": false,
      "properties": {
        "key": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "help": {
          "default": "",
          "type": "string"
        },
        "kind": {
          "const": "text",
          "type": "string"
        },
        "default": {
          "type": "string"
        },
        "maxLen": {
          "default": 500,
          "type": "integer"
        }
      },
      "required": [
        "key",
        "label",
        "default",
        "kind"
      ],
      "title": "TextParam",
      "type": "object"
    }
