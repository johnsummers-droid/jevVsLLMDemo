        "default": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "maxItems": {
          "default": 20,
          "type": "integer"
        },
        "maxLen": {
          "default": 60,
          "type": "integer"
        }
      },
      "required": [
        "key",
        "label",
        "default",
        "kind"
      ],
      "title": "StringListParam",
      "type": "object"
