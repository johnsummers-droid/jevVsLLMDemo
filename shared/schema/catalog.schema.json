        "help": {
          "default": "",
          "type": "string"
        },
        "kind": {
          "const": "multi_enum",
          "type": "string"
        },
        "default": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "options": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "type": "array"
        },
        "minSelected": {
          "default": 1,
          "type": "integer"
        }
