# Copy to server/.env for local overrides. Never commit .env; in production set these as
# host variables (Railway/Render), never in git.

# SQLite by default; postgres:// URLs are rewritten to postgresql+psycopg://.
DATABASE_URL=sqlite:///./dev.db
# Comma-separated exact origins.
ALLOWED_ORIGINS=http://localhost:5173
# Optional, e.g. ^https://jev-vs-llm-.*\.vercel\.app$ for Vercel previews.
ALLOWED_ORIGIN_REGEX=
# Needed to create a workshop session (T12).
FACILITATOR_CODE=
# Key for HMAC-hashing session and team tokens (T12). Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
TOKEN_SECRET=
LOG_LEVEL=info
# LLM for the answer generator: gemini (default) or claude. Its prices apply in mock mode too.
LLM_PROVIDER=gemini
# mock (default) or live. Live calls the real APIs through the call store (MVP step 2); the server
# refuses to start in live mode without the key below, or before that live provider exists.
JEV_MODE=mock
LLM_MODE=mock
# Server-only API keys. Never in web code or git.
TYPESAFE_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
# Real (uncached) provider calls stop for the rest of the UTC day at this spend.
LIVE_SPEND_CAP_USD=10
