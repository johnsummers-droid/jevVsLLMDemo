{
  "name": "Pipeline Simulator",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/node:1": {
      "version": "20"
    }
  },
  "forwardPorts": [5173, 8000],
  "portsAttributes": {
    "5173": { "label": "web (Vite)" },
    "8000": { "label": "server (FastAPI)" }
  },
  "postCreateCommand": "cd web && npm install && cd ../server && python -m venv .venv && .venv/bin/pip install -e '.[dev]'",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "dbaeumer.vscode-eslint"
      ]
    }
  }
}
